---
interface Props {
  title: string;
  description? : string;
}

const { title , description="AI Engineer and Frontend Engineer" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:title" content="Saumik Saha Kabbya" />
    <meta property="og:description" content="AI Engineer and Frontend Engineer building LLM and computer vision products." />
    <meta property="og:url" content="https://saumik-kabbya.vercel.app" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Saumik Saha Kabbya Portfolio" />
    <meta
      name="keywords"
      content="Saumik Saha Kabbya, AI Engineer, Frontend Engineer, Computer Vision, LLMs, Dhaka"
    />
    <meta name="author" content="Saumik Saha Kabbya" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      href="/fonts/Head%20Hunters.otf"
      as="font"
      type="font/otf"
      crossorigin
    />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&family=Syne:wght@400..800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&family=Syne:wght@400..800&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&family=Syne:wght@400..800&display=swap"
      />
    </noscript>

    <title>{title}</title>

    <script is:inline>
      const storedTheme = localStorage.getItem("theme");
      const prefersLight = window.matchMedia("(prefers-color-scheme: light)").matches;
      const initialTheme = storedTheme ?? (prefersLight ? "light" : "dark");
      document.documentElement.dataset.theme = initialTheme;
    </script>
  </head>
  <body class="bg-[--background] px-4 sm:px-6 md:px-10 lg:px-16 xl:px-20 antialiased">
    <div id="theme-transition" aria-hidden="true"></div>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --background: #0b1017;
    --surface: #111a27;
    --surface-strong: #162033;
    --border: #233043;
    --text: #e7edf5;
    --muted: #9aa7b5;
    --accent: #b7ff5a;
    --accent-2: #ff8a5c;
    --accent-3: #6ea8ff;
    --shadow-soft: 0 24px 60px rgba(4, 8, 16, 0.45);
    --shadow-strong: 0 40px 80px rgba(4, 8, 16, 0.6);
    --page-bg:
      radial-gradient(900px 500px at 10% -10%, rgba(110, 168, 255, 0.18), transparent 60%),
      radial-gradient(800px 500px at 90% 0%, rgba(183, 255, 90, 0.12), transparent 60%),
      radial-gradient(600px 400px at 60% 80%, rgba(255, 138, 92, 0.08), transparent 55%),
      #0b1017;
    --card-bg: linear-gradient(145deg, rgba(17, 26, 39, 0.92), rgba(10, 15, 23, 0.92));
    --timeline-bg: rgba(12, 18, 28, 0.6);
    --nav-bg: rgba(15, 22, 34, 0.78);
    --nav-bg-solid: rgba(15, 22, 34, 0.92);
    --input-bg: #0f1622;
    --sec: #b7ff5a;
    --white: #e7edf5;
    --white-icon: rgba(231, 237, 245, 0.68);
    --white-icon-tr: rgba(231, 237, 245, 0.12);
    --background-rgb: 11, 16, 23;
    --text-rgb: 231, 237, 245;
  }

  :root[data-theme="light"] {
    --background: #f6f7fb;
    --surface: #ffffff;
    --surface-strong: #eef1f6;
    --border: #d6dde8;
    --text: #1b2433;
    --muted: #5f6d7d;
    --accent: #2c7efb;        /* Blue accent for light theme */
    --accent-2: #ff7a59;      /* Consistent orange */
    --accent-3: #16a34a;      /* Consistent green */
    --shadow-soft: 0 22px 50px rgba(18, 28, 45, 0.12);
    --shadow-strong: 0 30px 70px rgba(18, 28, 45, 0.18);
    --page-bg:
      radial-gradient(900px 500px at 0% 0%, rgba(44, 126, 251, 0.14), transparent 55%),
      radial-gradient(600px 400px at 100% 10%, rgba(255, 122, 89, 0.12), transparent 50%),
      radial-gradient(600px 400px at 60% 80%, rgba(22, 163, 74, 0.08), transparent 55%),
      #f6f7fb;
    --card-bg: linear-gradient(145deg, rgba(255, 255, 255, 0.96), rgba(238, 242, 248, 0.95));
    --timeline-bg: rgba(255, 255, 255, 0.8);
    --nav-bg: rgba(255, 255, 255, 0.72);
    --nav-bg-solid: rgba(255, 255, 255, 0.9);
    --input-bg: #ffffff;
    --sec: #2c7efb;
    --white: #1b2433;
    --white-icon: rgba(27, 36, 51, 0.6);
    --white-icon-tr: rgba(27, 36, 51, 0.14);
    --background-rgb: 246, 247, 251;
    --text-rgb: 27, 36, 51;
  }

  /* Light theme scrollbar styles */
  :root[data-theme="light"]::-webkit-scrollbar-track {
    background: #f8fafc;
  }

  :root[data-theme="light"]::-webkit-scrollbar-thumb {
    background: #cbd5e1;
  }

  :root[data-theme="light"]::-webkit-scrollbar-thumb:hover {
    background: #a0aec0;
  }

  /* Light theme Firefox scrollbar */
  :root[data-theme="light"] {
    scrollbar-color: #a0aec0 #f8fafc;
  }

  * {
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  @font-face {
    font-family: "Head Hunters";
    src: url("/fonts/Head%20Hunters.otf") format("opentype");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  body {
    font-family:
      "Space Grotesk",
      -apple-system,
      system-ui,
      sans-serif;
    color: var(--text);
    background: var(--page-bg);
    min-height: 100vh;
    min-height: 100dvh;
    overflow-x: hidden;
    padding-bottom: env(safe-area-inset-bottom, 0px);
    transition: color 0.28s ease;
  }

  .font-display {
    font-family: "Syne", "Space Grotesk", system-ui, sans-serif;
    letter-spacing: -0.02em;
  }

  .font-handwritten,
  .font-handwritten .sticky-note-headline,
  .font-handwritten .sticky-note-body,
  .font-handwritten .skill-coop-list li,
  .font-handwritten .skill-coop-foot {
    font-family: "Head Hunters", "Segoe Print", cursive;
    font-weight: normal;
    letter-spacing: 0.015em;
  }

  html {
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
    color-scheme: dark light;
  }

  @supports (view-transition-name: none) {
    html {
      view-transition-name: theme;
    }

    ::view-transition-old(theme) {
      animation: theme-fade-out 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
      z-index: 1;
    }

    ::view-transition-new(theme) {
      animation: theme-expand-in 0.44s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      z-index: 2;
    }
  }

  @keyframes theme-fade-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes theme-expand-in {
    from {
      clip-path: circle(0 at var(--theme-origin-x, 50vw) var(--theme-origin-y, 50vh));
      opacity: 0.85;
    }
    to {
      clip-path: circle(150vmax at var(--theme-origin-x, 50vw) var(--theme-origin-y, 50vh));
      opacity: 1;
    }
  }

  #theme-transition {
    position: fixed;
    inset: 0;
    background: var(--background);
    opacity: 0;
    pointer-events: none;
    z-index: 999;
    transition: opacity 0.34s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: opacity;
  }

  :root.theme-fading #theme-transition {
    opacity: 0.28;
  }
  img,
  video,
  canvas,
  svg {
    max-width: 100%;
    height: auto;
  }

  *::selection {
    background-color: var(--accent);
    color: var(--background);
  }

  section {
    scroll-margin-top: 96px;
  }

  @media (max-width: 767px) {
    section {
      scroll-margin-top: 24px;
      scroll-margin-bottom: 96px;
    }
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.68rem;
    color: var(--muted);
    line-height: 1.5;
    word-break: break-word;
  }

  @media (min-width: 640px) {
    .eyebrow {
      letter-spacing: 0.28em;
      font-size: 0.72rem;
    }
  }

  @media (min-width: 768px) {
    .eyebrow {
      letter-spacing: 0.32em;
    }
  }

  .card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 20px;
    box-shadow: var(--shadow-soft);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  @media (min-width: 768px) {
    .card {
      border-radius: 24px;
    }
  }

  @media (hover: hover) {
    .card:hover {
      transform: translateY(-4px);
      border-color: var(--accent-3);
      box-shadow: var(--shadow-strong);
    }

    .card-flat:hover {
      transform: none;
      border-color: var(--border);
      box-shadow: var(--shadow-soft);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .project-card,
    .project-link,
    #theme-transition {
      transition: none !important;
      transform: none !important;
    }

    ::view-transition-old(theme),
    ::view-transition-new(theme) {
      animation: none !important;
    }
  }

  .text-gradient {
    background: linear-gradient(120deg, var(--text), var(--accent) 55%, var(--accent-3));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    background: rgba(17, 26, 39, 0.7);
    border: 1px solid var(--border);
    color: var(--text);
  }

  /* Updated chip for light theme */
  :root[data-theme="light"] .chip {
    background: rgba(255, 255, 255, 0.7);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.65rem 1.05rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.9rem;
    line-height: 1.2;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  @media (min-width: 640px) {
    .btn {
      padding: 0.7rem 1.2rem;
      font-size: 0.95rem;
    }
  }

  .btn-primary {
    background: var(--accent);
    color: var(--background);
    box-shadow: 0 12px 30px rgba(183, 255, 90, 0.25);
  }

  /* Adjust btn-primary for light theme */
  :root[data-theme="light"] .btn-primary {
    color: var(--white);
    box-shadow: 0 12px 30px rgba(44, 126, 251, 0.25);
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 18px 40px rgba(183, 255, 90, 0.35);
  }

  /* Adjust btn-primary:hover for light theme */
  :root[data-theme="light"] .btn-primary:hover {
    box-shadow: 0 18px 40px rgba(44, 126, 251, 0.35);
  }

  .btn-outline {
    border: 1px solid var(--border);
    color: var(--text);
    background: rgba(16, 24, 36, 0.6);
  }

  /* Adjust btn-outline for light theme */
  :root[data-theme="light"] .btn-outline {
    background: rgba(255, 255, 255, 0.6);
  }

  .btn-outline:hover {
    border-color: var(--accent-3);
    color: var(--accent-3);
  }

  .btn-ghost {
    border: 1px dashed var(--border);
    color: var(--text);
    background: transparent;
  }

  .btn-ghost:hover {
    border-color: var(--accent-2);
    color: var(--accent-2);
  }

  /* Scrollbar styles */

  ::-webkit-scrollbar {
    width: 15px;
  }

  ::-webkit-scrollbar-track {
    background: #0f1622;
    border-radius: 30px;
  }

  ::-webkit-scrollbar-thumb {
    background: #1f2a3a;
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: #2b3a50;
  }

  /* Scrollbar styles for Firefox */
  * {
    scrollbar-width: thin;
    scrollbar-color: #2b3a50 #0f1622;
  }
</style>
