---
import LetterGlitch from "../React/LetterGlitch.tsx";
import LogoWall from "../components/logoWall.astro";
import SkillsList from "../React/SkillsList.tsx";
import AnimatedImage from "./animate";
import { education, experience, projects, formatPeriod } from "@/data/portfolio";

const capstone = projects.find((project) => project.id === "airis");
const primaryEducation = education[0];
const educationPeriod = primaryEducation
  ? formatPeriod(primaryEducation.start, primaryEducation.end)
  : "";
const capstonePeriod = capstone ? formatPeriod(capstone.start, capstone.end) : "";
---

<section class="text-[var(--text)] mt-12 md:mt-0" id="home">
  <div class="max-w-6xl mx-auto md:py-28 pb-16 space-y-16">
    <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-12 items-center">
      <div class="space-y-8">
        <p class="eyebrow">AI Engineer · Frontend Engineer · Dhaka, Bangladesh</p>
        <div class="space-y-5">
          <h1 class="font-display text-4xl md:text-6xl leading-tight">
            Building intelligent,
            <span class="text-gradient">human-first</span> products.
          </h1>
          <p class="text-lg text-[var(--muted)] max-w-xl">
            I’m Saumik Saha Kabbya, a CSE graduate crafting LLM and computer
            vision systems, then shaping them into polished web experiences.
            I care about speed, clarity, and accessibility from prototype to launch.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a class="btn btn-primary" href="/#projects">View Projects</a>
          <a class="btn btn-outline" href="/#experience">Experience</a>
          <a
            class="btn btn-ghost"
            href="/saumik-saha-kabbya-resume.pdf"
            target="_blank"
            rel="noreferrer"
          >
            Resume
          </a>
        </div>
        <div class="grid sm:grid-cols-3 grid-cols-2 gap-4">
          <div class="card px-5 py-4">
            <p class="text-sm text-[var(--muted)]">Focus</p>
            <p class="text-lg font-semibold">LLMs & Vision</p>
          </div>
          <div class="card px-5 py-4">
            <p class="text-sm text-[var(--muted)]">Stack</p>
            <p class="text-lg font-semibold">FastAPI · Next.js</p>
          </div>
          <div class="card px-5 py-4">
            <p class="text-sm text-[var(--muted)]">Signature</p>
            <p class="text-lg font-semibold">Fast, tactile, human-friendly UX.</p>
          </div>
        </div>
        <div class="flex items-center gap-3 text-[var(--muted)] text-sm">
          <span class="chip">Email</span>
          <a class="hover:text-[var(--text)] transition" href="mailto:saumik.kabbya@gmail.com">
            saumik.kabbya@gmail.com
          </a>
        </div>
      </div>

      <div class="relative">
        <div class="absolute -top-12 -right-8 w-48 h-48 rounded-full bg-[var(--accent)]/20 blur-3xl"></div>
        <div class="card p-6 hero-image-card">
          <AnimatedImage client:load />
          <div class="mt-6 space-y-3">
            <div class="flex items-center justify-between">
              <span class="chip">Currently building</span>
              <a
                id="current-link"
                class="text-sm text-[var(--muted)] hover:text-[var(--text)] transition"
                href="https://github.com/Kabbya04"
                target="_blank"
                rel="noreferrer"
              >
                AIris · Zappy
              </a>
            </div>
            <p id="current-desc" class="text-sm text-[var(--muted)]">
              Local-first vision assistance, LLM-powered recommendation systems,
              and multi-conversation chat platforms.
            </p>
            <p id="current-time" class="text-xs text-[var(--muted)]">
              Syncing with GitHub…
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="space-y-3">
      <p class="eyebrow">Core stack</p>
      <LogoWall />
    </div>

    <section id="telemetry" class="space-y-6">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <div class="space-y-2">
          <p class="eyebrow">Live</p>
          <h2 class="font-display text-3xl md:text-4xl">Build telemetry</h2>
        </div>
        <p class="text-[var(--muted)] max-w-xl">
          Real-time public GitHub activity and runtime signal from this deployed site.
        </p>
      </div>

      <div class="card p-6 space-y-5">
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <div class="telemetry-item">
            <p class="telemetry-label">Active repo</p>
            <a
              id="telemetry-repo"
              href="https://github.com/Kabbya04"
              target="_blank"
              rel="noreferrer"
              class="telemetry-value hover:text-[var(--text)] transition"
            >
              Loading...
            </a>
          </div>
          <div class="telemetry-item">
            <p class="telemetry-label">Last push</p>
            <p id="telemetry-last-push" class="telemetry-value">Loading...</p>
          </div>
          <div class="telemetry-item">
            <p class="telemetry-label">Pushes (7d)</p>
            <p id="telemetry-pushes-7d" class="telemetry-value">Loading...</p>
          </div>
          <div class="telemetry-item">
            <p class="telemetry-label">Push streak</p>
            <p id="telemetry-streak" class="telemetry-value">Loading...</p>
          </div>
          <div class="telemetry-item">
            <p class="telemetry-label">Public repos</p>
            <p id="telemetry-public-repos" class="telemetry-value">Loading...</p>
          </div>
          <div class="telemetry-item">
            <p class="telemetry-label">Site RTT</p>
            <p id="telemetry-rtt" class="telemetry-value">Loading...</p>
          </div>
        </div>
        <p id="telemetry-updated" class="text-xs text-[var(--muted)]">
          Syncing telemetry...
        </p>
      </div>
    </section>

    <section id="experience" class="space-y-8">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <div class="space-y-2">
          <p class="eyebrow">Experience</p>
          <h2 class="font-display text-3xl md:text-4xl">
            Shipping AI + product experiences
          </h2>
        </div>
        <p class="text-[var(--muted)] max-w-xl">
          I work across backend intelligence and frontend polish, turning models into
          clear, responsive products.
        </p>
      </div>
      <div class="grid lg:grid-cols-2 gap-6">
        {experience.map((role) => (
          <div class="card p-6 space-y-4">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="text-xl font-semibold">{role.title}</h3>
                <p class="text-sm text-[var(--muted)]">
                  {role.subtitle} · {formatPeriod(role.start, role.end)}
                </p>
              </div>
              <span class="chip">Client work</span>
            </div>
            {role.description && (
              <p class="text-[var(--muted)]">{role.description}</p>
            )}
            {role.tags && (
              <div class="flex flex-wrap gap-2">
                {role.tags.map((tag) => (
                  <span class="chip">{tag}</span>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <section id="education" class="space-y-8">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <div class="space-y-2">
          <p class="eyebrow">Education & Capstone</p>
          <h2 class="font-display text-3xl md:text-4xl">
            Academic focus and applied research
          </h2>
        </div>
        <p class="text-[var(--muted)] max-w-xl">
          Balancing core CS fundamentals with hands-on AI systems built for real-world impact.
        </p>
      </div>
      <div class="grid lg:grid-cols-2 gap-6">
        <div class="card p-6 space-y-4">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h3 class="text-xl font-semibold">{primaryEducation?.title}</h3>
              <p class="text-sm text-[var(--muted)]">
                {primaryEducation?.subtitle} · {educationPeriod}
              </p>
            </div>
            <span class="chip">Dhaka, Bangladesh</span>
          </div>
          {primaryEducation?.description && (
            <p class="text-[var(--muted)]">{primaryEducation.description}</p>
          )}
          {primaryEducation?.tags && (
            <div class="flex flex-wrap gap-2">
              {primaryEducation.tags.map((tag) => (
                <span class="chip">{tag}</span>
              ))}
            </div>
          )}
        </div>
        <div class="card p-6 space-y-4">
          <div class="flex items-start justify-between gap-4 flex-wrap">
            <div>
              <h3 class="text-xl font-semibold">Capstone · {capstone?.title}</h3>
              <p class="text-sm text-[var(--muted)]">
                {capstonePeriod} · {capstone?.subtitle}
              </p>
            </div>
            <a
              class="btn btn-outline text-sm"
              href={capstone?.github ?? "https://github.com/rajin-khan/AIris"}
              target="_blank"
              rel="noreferrer"
            >
              View on GitHub
            </a>
          </div>
          {capstone?.description && (
            <p class="text-[var(--muted)]">{capstone.description}</p>
          )}
          {capstone?.tags && (
            <div class="flex flex-wrap gap-2">
              {capstone.tags.map((tag) => (
                <span class="chip">{tag}</span>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>

    <section id="skills" class="space-y-8">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <div class="space-y-2">
          <p class="eyebrow">Skills</p>
          <h2 class="font-display text-3xl md:text-4xl">
            A focused, modern toolbox
          </h2>
        </div>
        <p class="text-[var(--muted)] max-w-xl">
          From systems and models to UI and product polish, I keep the stack tight and the
          delivery fast.
        </p>
      </div>
      <div class="grid lg:grid-cols-[1.2fr_0.8fr] gap-8 items-center">
        <SkillsList client:load />
        <div class="card p-6 flex items-center justify-center h-64 md:h-80">
          <LetterGlitch
            client:load
            glitchColors={["#b7ff5a", "#6ea8ff", "#ff8a5c"]}
            glitchSpeed={28}
            centerVignette={false}
            outerVignette={true}
            smooth={true}
          />
        </div>
      </div>
    </section>
  </div>
</section>

<style>
  .hero-image-card:hover {
    border-color: transparent;
    background: transparent;
    box-shadow: none;
    transform: translateY(0);
  }

  .hero-image-card {
    transition: background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .telemetry-item {
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 0.85rem 1rem;
    background: color-mix(in srgb, var(--surface) 78%, transparent);
  }

  .telemetry-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    margin-bottom: 0.35rem;
  }

  .telemetry-value {
    font-size: 1rem;
    color: var(--text);
    font-weight: 600;
  }
</style>

<script type="module" is:inline>
  const username = "Kabbya04";
  const repoLink = document.getElementById("current-link");
  const descEl = document.getElementById("current-desc");
  const timeEl = document.getElementById("current-time");
  const telemetryRepo = document.getElementById("telemetry-repo");
  const telemetryLastPush = document.getElementById("telemetry-last-push");
  const telemetryPushes7d = document.getElementById("telemetry-pushes-7d");
  const telemetryStreak = document.getElementById("telemetry-streak");
  const telemetryPublicRepos = document.getElementById("telemetry-public-repos");
  const telemetryRtt = document.getElementById("telemetry-rtt");
  const telemetryUpdated = document.getElementById("telemetry-updated");

  const truncate = (text, max = 140) => {
    if (!text || text.length <= max) return text;
    return `${text.slice(0, max - 1)}…`;
  };

  const formatRelative = (iso) => {
    if (!iso) return "Recently updated";
    const diff = Date.now() - new Date(iso).getTime();
    const minutes = Math.floor(diff / 60000);
    if (minutes < 1) return "Just now";
    if (minutes < 60) return `${minutes}m ago`;
    const hours = Math.floor(minutes / 60);
    if (hours < 24) return `${hours}h ago`;
    const days = Math.floor(hours / 24);
    if (days < 7) return `${days}d ago`;
    const weeks = Math.floor(days / 7);
    return `${weeks}w ago`;
  };

  const formatDateKey = (iso) => {
    const date = new Date(iso);
    const year = date.getUTCFullYear();
    const month = String(date.getUTCMonth() + 1).padStart(2, "0");
    const day = String(date.getUTCDate()).padStart(2, "0");
    return `${year}-${month}-${day}`;
  };

  const computePushStreak = (pushEvents) => {
    if (!pushEvents.length) return 0;
    const uniqueDays = new Set(pushEvents.map((event) => formatDateKey(event.created_at)));
    let streak = 0;
    const cursor = new Date();
    cursor.setUTCHours(0, 0, 0, 0);

    while (true) {
      const year = cursor.getUTCFullYear();
      const month = String(cursor.getUTCMonth() + 1).padStart(2, "0");
      const day = String(cursor.getUTCDate()).padStart(2, "0");
      const key = `${year}-${month}-${day}`;
      if (!uniqueDays.has(key)) break;
      streak += 1;
      cursor.setUTCDate(cursor.getUTCDate() - 1);
    }

    return streak;
  };

  const countPushesInLastDays = (pushEvents, days = 7) => {
    const cutoff = Date.now() - days * 24 * 60 * 60 * 1000;
    return pushEvents.filter((event) => new Date(event.created_at).getTime() >= cutoff).length;
  };

  const measureSiteRtt = async () => {
    const start = performance.now();
    await fetch(`${window.location.origin}/?telemetry=${Date.now()}`, {
      method: "GET",
      cache: "no-store",
    });
    return Math.round(performance.now() - start);
  };

  const fetchAllEvents = async () => {
    const pages = [1, 2, 3];
    const results = await Promise.all(
      pages.map(async (page) => {
        const response = await fetch(
          `https://api.github.com/users/${username}/events/public?per_page=100&page=${page}`,
          { headers: { Accept: "application/vnd.github+json" } }
        );
        if (!response.ok) return [];
        return response.json();
      })
    );
    return results.flat();
  };

  const loadTelemetry = async () => {
    const [events, userRes, rtt] = await Promise.all([
      fetchAllEvents(),
      fetch(`https://api.github.com/users/${username}`, {
        headers: { Accept: "application/vnd.github+json" },
      }),
      measureSiteRtt(),
    ]);

    const pushEvents = events.filter((event) => event.type === "PushEvent");
    const latestPush = pushEvents[0];

    if (telemetryRtt) {
      telemetryRtt.textContent = `${rtt} ms`;
    }

    if (userRes.ok && telemetryPublicRepos) {
      const userData = await userRes.json();
      telemetryPublicRepos.textContent = String(userData.public_repos ?? "N/A");
    }

    telemetryPushes7d && (telemetryPushes7d.textContent = String(countPushesInLastDays(pushEvents, 7)));
    telemetryStreak && (telemetryStreak.textContent = `${computePushStreak(pushEvents)} days`);

    if (!latestPush) {
      if (timeEl) {
        timeEl.textContent = "No recent public push found.";
      }
      if (telemetryUpdated) {
        telemetryUpdated.textContent = "No recent push data available.";
      }
      return;
    }

    const repoName = latestPush?.repo?.name;
    const commits = latestPush?.payload?.commits || [];
    const commit = commits[commits.length - 1];
    const message = commit?.message;

    telemetryLastPush && (telemetryLastPush.textContent = formatRelative(latestPush.created_at));

    if (repoName) {
      const shortRepo = repoName.split("/")[1] || repoName;
      if (repoLink) {
        repoLink.textContent = shortRepo;
        repoLink.href = `https://github.com/${repoName}`;
      }
      if (telemetryRepo) {
        telemetryRepo.textContent = shortRepo;
        telemetryRepo.href = `https://github.com/${repoName}`;
      }

      let repoDescription = "";
      try {
        const repoRes = await fetch(`https://api.github.com/repos/${repoName}`, {
          headers: { Accept: "application/vnd.github+json" },
        });
        if (repoRes.ok) {
          const repoData = await repoRes.json();
          repoDescription = repoData?.description || "";
        }
      } catch {
        repoDescription = "";
      }

      if (descEl) {
        descEl.textContent =
          repoDescription?.trim().length > 0
            ? truncate(repoDescription)
            : message
              ? `Latest commit: ${truncate(message)}`
              : "Latest public push detected.";
      }
    }

    if (timeEl) {
      timeEl.textContent = `Updated ${formatRelative(latestPush.created_at)}`;
    }
    if (telemetryUpdated) {
      telemetryUpdated.textContent = `Synced ${formatRelative(new Date().toISOString())}`;
    }
  };

  loadTelemetry().catch(() => {
    if (timeEl) {
      timeEl.textContent = "Unable to sync with GitHub right now.";
    }
    if (telemetryUpdated) {
      telemetryUpdated.textContent = "Telemetry unavailable at the moment.";
    }
    if (telemetryLastPush) {
      telemetryLastPush.textContent = "N/A";
    }
    if (telemetryPushes7d) {
      telemetryPushes7d.textContent = "N/A";
    }
    if (telemetryStreak) {
      telemetryStreak.textContent = "N/A";
    }
    if (telemetryPublicRepos) {
      telemetryPublicRepos.textContent = "N/A";
    }
    if (telemetryRtt) {
      telemetryRtt.textContent = "N/A";
    }
  });

  // Update glitch colors based on theme
  const updateGlitchColors = () => {};

  // Listen for theme changes
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (mutation.type === "attributes" && mutation.attributeName === "data-theme") {
        updateGlitchColors();
      }
    });
  });

  observer.observe(document.documentElement, { attributes: true });
</script>
