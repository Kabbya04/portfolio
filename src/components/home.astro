---
import LetterGlitch from "../React/LetterGlitch.tsx";
import LogoWall from "../components/logoWall.astro";
import SkillsList from "../React/SkillsList.tsx";
import AnimatedImage from "./animate";
import { education, experience, projects, formatPeriod } from "@/data/portfolio";

const capstone = projects.find((project) => project.id === "airis");
const primaryEducation = education[0];
const educationPeriod = primaryEducation
  ? formatPeriod(primaryEducation.start, primaryEducation.end)
  : "";
const capstonePeriod = capstone ? formatPeriod(capstone.start, capstone.end) : "";
---

<section class="text-[var(--text)] mt-12 md:mt-0" id="home">
  <div class="max-w-6xl mx-auto md:py-28 pb-16 space-y-16">
    <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-12 items-center">
      <div class="space-y-8">
        <p class="eyebrow">AI Engineer · Frontend Engineer · Dhaka, Bangladesh</p>
        <div class="space-y-5">
          <h1 class="font-display text-4xl md:text-6xl leading-tight">
            Building intelligent,
            <span class="text-gradient">human-first</span> products.
          </h1>
          <p class="text-lg text-[var(--muted)] max-w-xl">
            I’m Saumik Saha Kabbya, a CSE graduate crafting LLM and computer
            vision systems, then shaping them into polished web experiences.
            I care about speed, clarity, and accessibility from prototype to launch.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a class="btn btn-primary" href="/#projects">View Projects</a>
          <a class="btn btn-outline" href="/#experience">Experience</a>
          <a
            class="btn btn-ghost"
            href="/saumik-saha-kabbya-resume.pdf"
            target="_blank"
            rel="noreferrer"
          >
            Resume
          </a>
        </div>
        <div class="grid sm:grid-cols-3 grid-cols-2 gap-4">
          <div class="card px-5 py-4">
            <p class="text-sm text-[var(--muted)]">Focus</p>
            <p class="text-lg font-semibold">LLMs & Vision</p>
          </div>
          <div class="card px-5 py-4">
            <p class="text-sm text-[var(--muted)]">Stack</p>
            <p class="text-lg font-semibold">FastAPI · Next.js</p>
          </div>
          <div class="card px-5 py-4">
            <p class="text-sm text-[var(--muted)]">Signature</p>
            <p class="text-lg font-semibold">Fast, tactile, human-friendly UX.</p>
          </div>
        </div>
        <div class="flex items-center gap-3 text-[var(--muted)] text-sm">
          <span class="chip">Email</span>
          <a class="hover:text-[var(--text)] transition" href="mailto:saumik.kabbya@gmail.com">
            saumik.kabbya@gmail.com
          </a>
        </div>
      </div>

      <div class="relative">
        <div class="absolute -top-12 -right-8 w-48 h-48 rounded-full bg-[var(--accent)]/20 blur-3xl"></div>
        <div class="card p-6 hero-image-card">
          <AnimatedImage client:load />
          <div class="mt-6 space-y-3">
            <div class="flex items-center justify-between">
              <span class="chip">Currently building</span>
              <a
                id="current-link"
                class="text-sm text-[var(--muted)] hover:text-[var(--text)] transition"
                href="https://github.com/Kabbya04"
                target="_blank"
                rel="noreferrer"
              >
                AIris · Zappy
              </a>
            </div>
            <p id="current-desc" class="text-sm text-[var(--muted)]">
              Local-first vision assistance, LLM-powered recommendation systems,
              and multi-conversation chat platforms.
            </p>
            <p id="current-time" class="text-xs text-[var(--muted)]">
              Syncing with GitHub…
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="space-y-3">
      <p class="eyebrow">Core stack</p>
      <LogoWall />
    </div>

    <section id="experience" class="space-y-8">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <div class="space-y-2">
          <p class="eyebrow">Experience</p>
          <h2 class="font-display text-3xl md:text-4xl">
            Shipping AI + product experiences
          </h2>
        </div>
        <p class="text-[var(--muted)] max-w-xl">
          I work across backend intelligence and frontend polish, turning models into
          clear, responsive products.
        </p>
      </div>
      <div class="grid lg:grid-cols-2 gap-6">
        {experience.map((role) => (
          <div class="card p-6 space-y-4">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="text-xl font-semibold">{role.title}</h3>
                <p class="text-sm text-[var(--muted)]">
                  {role.subtitle} · {formatPeriod(role.start, role.end)}
                </p>
              </div>
              <span class="chip">Client work</span>
            </div>
            {role.description && (
              <p class="text-[var(--muted)]">{role.description}</p>
            )}
            {role.tags && (
              <div class="flex flex-wrap gap-2">
                {role.tags.map((tag) => (
                  <span class="chip">{tag}</span>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <section id="education" class="space-y-8">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <div class="space-y-2">
          <p class="eyebrow">Education & Capstone</p>
          <h2 class="font-display text-3xl md:text-4xl">
            Academic focus and applied research
          </h2>
        </div>
        <p class="text-[var(--muted)] max-w-xl">
          Balancing core CS fundamentals with hands-on AI systems built for real-world impact.
        </p>
      </div>
      <div class="grid lg:grid-cols-2 gap-6">
        <div class="card p-6 space-y-4">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h3 class="text-xl font-semibold">{primaryEducation?.title}</h3>
              <p class="text-sm text-[var(--muted)]">
                {primaryEducation?.subtitle} · {educationPeriod}
              </p>
            </div>
            <span class="chip">Dhaka, Bangladesh</span>
          </div>
          {primaryEducation?.description && (
            <p class="text-[var(--muted)]">{primaryEducation.description}</p>
          )}
          {primaryEducation?.tags && (
            <div class="flex flex-wrap gap-2">
              {primaryEducation.tags.map((tag) => (
                <span class="chip">{tag}</span>
              ))}
            </div>
          )}
        </div>
        <div class="card p-6 space-y-4">
          <div class="flex items-start justify-between gap-4 flex-wrap">
            <div>
              <h3 class="text-xl font-semibold">Capstone · {capstone?.title}</h3>
              <p class="text-sm text-[var(--muted)]">
                {capstonePeriod} · {capstone?.subtitle}
              </p>
            </div>
            <a
              class="btn btn-outline text-sm"
              href={capstone?.github ?? "https://github.com/rajin-khan/AIris"}
              target="_blank"
              rel="noreferrer"
            >
              View on GitHub
            </a>
          </div>
          {capstone?.description && (
            <p class="text-[var(--muted)]">{capstone.description}</p>
          )}
          {capstone?.tags && (
            <div class="flex flex-wrap gap-2">
              {capstone.tags.map((tag) => (
                <span class="chip">{tag}</span>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>

    <section id="skills" class="space-y-8">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <div class="space-y-2">
          <p class="eyebrow">Skills</p>
          <h2 class="font-display text-3xl md:text-4xl">
            A focused, modern toolbox
          </h2>
        </div>
        <p class="text-[var(--muted)] max-w-xl">
          From systems and models to UI and product polish, I keep the stack tight and the
          delivery fast.
        </p>
      </div>
      <div class="grid lg:grid-cols-[1.2fr_0.8fr] gap-8 items-center">
        <SkillsList client:load />
        <div class="card p-6 flex items-center justify-center h-64 md:h-80">
          <LetterGlitch
            client:load
            glitchColors={["#b7ff5a", "#6ea8ff", "#ff8a5c"]}
            glitchSpeed={28}
            centerVignette={false}
            outerVignette={true}
            smooth={true}
          />
        </div>
      </div>
    </section>
  </div>
</section>

<style>
  .hero-image-card:hover {
    border-color: transparent;
    background: transparent;
    box-shadow: none;
    transform: translateY(0);
  }

  .hero-image-card {
    transition: background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }
</style>

<script type="module" is:inline>
  const username = "Kabbya04";
  const repoLink = document.getElementById("current-link");
  const descEl = document.getElementById("current-desc");
  const timeEl = document.getElementById("current-time");

  const truncate = (text, max = 140) => {
    if (!text || text.length <= max) return text;
    return `${text.slice(0, max - 1)}…`;
  };

  const formatRelative = (iso) => {
    if (!iso) return "Recently updated";
    const diff = Date.now() - new Date(iso).getTime();
    const minutes = Math.floor(diff / 60000);
    if (minutes < 1) return "Just now";
    if (minutes < 60) return `${minutes}m ago`;
    const hours = Math.floor(minutes / 60);
    if (hours < 24) return `${hours}h ago`;
    const days = Math.floor(hours / 24);
    if (days < 7) return `${days}d ago`;
    const weeks = Math.floor(days / 7);
    return `${weeks}w ago`;
  };

  const loadLatestPush = async () => {
    const response = await fetch(
      `https://api.github.com/users/${username}/events/public`,
      {
        headers: { Accept: "application/vnd.github+json" },
      }
    );
    if (!response.ok) {
      throw new Error("GitHub API error");
    }
    const events = await response.json();
    const pushEvent = events.find((event) => event.type === "PushEvent");
    if (!pushEvent) return;

    const repoName = pushEvent?.repo?.name;
    if (!repoName) return;
    const commits = pushEvent?.payload?.commits || [];
    const commit = commits[commits.length - 1];
    const message = commit?.message;

    let repoDescription = "";
    try {
      const repoRes = await fetch(`https://api.github.com/repos/${repoName}`, {
        headers: { Accept: "application/vnd.github+json" },
      });
      if (repoRes.ok) {
        const repoData = await repoRes.json();
        repoDescription = repoData?.description || "";
      }
    } catch {
      repoDescription = "";
    }

    if (repoLink) {
      repoLink.textContent = repoName.split("/")[1] || repoName;
      repoLink.href = `https://github.com/${repoName}`;
    }

    if (descEl) {
      descEl.textContent =
        repoDescription?.trim().length > 0
          ? truncate(repoDescription)
          : message
            ? `Latest commit: ${truncate(message)}`
            : "Latest public push detected.";
    }

    if (timeEl) {
      timeEl.textContent = `Updated ${formatRelative(pushEvent.created_at)}`;
    }
  };

  loadLatestPush().catch(() => {
    if (timeEl) {
      timeEl.textContent = "Unable to sync with GitHub right now.";
    }
  });
</script>
