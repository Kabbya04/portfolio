---
import type { Project } from "@/data/projects";
import { projectPeriod } from "@/data/projects";
import ProjectVisual from "./ProjectVisual.astro";

interface Props {
  project: Project;
  featured?: boolean;
  compact?: boolean;
  index?: number;
}

const { project, featured = false, compact = false, index } = Astro.props;
const period = projectPeriod(project);
---

<article class:list={["project-card", { "project-card--featured": featured, "project-card--compact": compact }]}>
  <a class="project-card__media" href={`/projects/${project.slug}`}>
    <ProjectVisual
      title={project.title}
      subtitle={project.subtitle}
      label={project.visualLabel}
      accent={project.accent}
      period={period}
      index={index}
      tags={project.tags}
      large={featured && !compact}
    />
  </a>

  <div class="project-card__body">
    <p class="project-card__summary">{project.summary}</p>
    {
      !compact && !featured && (
        <div class="project-card__tags">
          {project.tags.slice(0, 4).map((tag) => (
            <span class="chip">{tag}</span>
          ))}
        </div>
      )
    }
    <div class="project-card__links">
      <a class="btn-text" href={`/projects/${project.slug}`}>Case study</a>
      {
        project.live && (
          <a class="btn-text" href={project.live} target="_blank" rel="noreferrer">
            Live
          </a>
        )
      }
      {
        project.github && (
          <a
            class="btn-text"
            href={project.github}
            target="_blank"
            rel="noreferrer"
          >
            GitHub
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .project-card {
    display: grid;
    gap: 1.1rem;
  }

  .project-card--featured {
    gap: 1.15rem;
  }

  .project-card__media {
    text-decoration: none;
    transition: opacity 180ms var(--ease-out);
  }

  .project-card__media:hover {
    opacity: 0.96;
  }

  .project-card__media :global(.project-visual) {
    transition: transform 220ms var(--ease-out);
  }

  .project-card__media:hover :global(.project-visual) {
    transform: scale(1.012);
  }

  .project-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.15rem;
    margin-bottom: 0.55rem;
  }

  .project-card__summary {
    margin: 0;
    max-width: 42rem;
    color: var(--text-muted);
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.9rem;
  }

  .project-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1.15rem;
    margin-top: 1rem;
  }

  .project-card--compact .project-card__links,
  .project-card--featured .project-card__links {
    margin-top: 0.85rem;
  }
</style>
