---
import LikeButton from "../React/LikeButton.tsx";
---

<footer class="w-full py-14 border-t border-[var(--border)]">
  <div class="max-w-6xl mx-auto space-y-10">
    <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.7fr_0.7fr_0.9fr] gap-8">
      <div class="space-y-6">
        <div class="space-y-3">
          <p class="eyebrow">Saumik Saha Kabbya</p>
          <p class="text-lg text-[var(--muted)] max-w-md">
            AI engineer crafting fast, accessible, and human-first experiences.
          </p>
        </div>
        <div class="flex items-center gap-4">
          {
            [
              {
                href: "https://github.com/Kabbya04",
                icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6"><path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"></path></svg>',
                label: "GitHub",
              },
              {
                href: "https://www.linkedin.com/in/saumik-saha-kabbya/",
                icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6"><path d="M18.3362 18.339H15.6707V14.1622C15.6707 13.1662 15.6505 11.8845 14.2817 11.8845C12.892 11.8845 12.6797 12.9683 12.6797 14.0887V18.339H10.0142V9.75H12.5747V10.9207H12.6092C12.967 10.2457 13.837 9.53325 15.1367 9.53325C17.8375 9.53325 18.337 11.3108 18.337 13.6245V18.339H18.3362ZM7.00373 8.57475C6.14573 8.57475 5.45648 7.88025 5.45648 7.026C5.45648 6.1725 6.14648 5.47875 7.00373 5.47875C7.85873 5.47875 8.55173 6.1725 8.55173 7.026C8.55173 7.88025 7.85798 8.57475 7.00373 8.57475ZM8.34023 18.339H5.66723V9.75H8.34023V18.339ZM19.6697 3H4.32923C3.59498 3 3.00098 3.5805 3.00098 4.29675V19.7033C3.00098 20.4202 3.59498 21 4.32923 21H19.6675C20.401 21 21.001 20.4202 21.001 19.7033V4.29675C21.001 3.5805 20.401 3 19.6675 3H19.6697Z"></path></svg>',
                label: "LinkedIn",
              },
              {
                href: "mailto:saumik.kabbya@gmail.com",
                icon: '<svg xmlns="http://www.w3.org/2000/svg" width="2em" height="2em" viewBox="0 0 24 24"><path fill="currentColor" d="m18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64"/></svg>',
                label: "Email",
              },
            ].map((link) => (
              <a
                href={link.href}
                target="_blank"
                class="p-2 rounded-full border border-[var(--border)] text-[var(--muted)] hover:text-[var(--text)] hover:border-[var(--accent)] transition"
                aria-label={link.label}
                rel="noreferrer"
              >
                <div set:html={link.icon} />
              </a>
            ))
          }
        </div>
        <LikeButton client:load />
      </div>

      <div class="space-y-4">
        <p class="text-sm text-[var(--muted)] uppercase tracking-[0.28em]">Navigate</p>
        <div class="flex flex-col gap-2 text-[var(--muted)]">
          <a class="hover:text-[var(--text)] transition" href="/#home">Home</a>
          <a class="hover:text-[var(--text)] transition" href="/#experience">Experience</a>
          <a class="hover:text-[var(--text)] transition" href="/#projects">Projects</a>
          <a class="hover:text-[var(--text)] transition" href="/#skills">Skills</a>
          <a class="hover:text-[var(--text)] transition" href="/#contact">Contact</a>
          <a class="hover:text-[var(--text)] transition" href="/about">About</a>
        </div>
      </div>

      <div class="space-y-4">
        <p class="text-sm text-[var(--muted)] uppercase tracking-[0.28em]">Stack</p>
        <div class="grid grid-cols-1 gap-3 w-full max-w-xs text-[var(--muted)] text-sm">
          <div class="flex items-center space-x-3">
            <img
              src="/svg/astro.svg"
              alt="Astro Logo"
              class="h-5 w-5 object-contain filter brightness-0 invert opacity-60"
              loading="lazy"
            />
            <span>Astro</span>
          </div>
          <div class="flex items-center space-x-3">
            <img
              src="/svg/tailwindcss.svg"
              alt="TailwindCSS Logo"
              class="h-5 w-5 object-contain filter brightness-0 invert opacity-60"
              loading="lazy"
            />
            <span>Tailwind CSS</span>
          </div>
          <div class="flex items-center space-x-3">
            <img
              src="/svg/vercel.svg"
              alt="Vercel Logo"
              class="h-5 w-5 object-contain filter brightness-0 invert opacity-60"
              loading="lazy"
            />
            <span>Vercel</span>
          </div>
        </div>
      </div>

    </div>

    <div class="mt-10 pt-6 border-t border-[var(--border)] text-sm text-[var(--muted)]">
      <p class="text-center">
        © 2026 Saumik Saha Kabbya. Template credit:
        <a class="hover:text-[var(--text)] transition" href="https://github.com/Gothsec">
          Oscar Hernandez
        </a>.
      </p>
    </div>
  </div>
</footer>
