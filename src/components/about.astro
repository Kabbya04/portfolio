---
import { education, experience, projects, formatPeriod } from "@/data/portfolio";

const timelineEntries = [
  ...education.map((entry, index) => ({ ...entry, order: index })),
  ...experience.map((entry, index) => ({
    ...entry,
    order: education.length + index,
  })),
  ...projects.map((entry, index) => ({
    ...entry,
    order: education.length + experience.length + index,
  })),
];

const parseStartIndex = (value: string) => {
  const [year, month] = value.split("-");
  const y = Number(year);
  const m = month ? Number(month) : 1;
  return y * 12 + m;
};

const sortedTimeline = [...timelineEntries].sort((a, b) => {
  const diff = parseStartIndex(b.start) - parseStartIndex(a.start);
  return diff !== 0 ? diff : a.order - b.order;
});
---

<section class="text-[var(--text)] mt-12 md:mt-0" id="about">
  <div class="max-w-6xl mx-auto md:py-28 pb-16 space-y-14">
    <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-12 items-center">
      <div class="space-y-6">
        <p class="eyebrow">About</p>
        <h1 class="font-display text-4xl md:text-5xl leading-tight">
          Designing AI experiences that feel intuitive.
        </h1>
        <p class="text-lg text-[var(--muted)]">
          I’m Saumik Saha Kabbya, a computer science student in Dhaka with a focus on
          LLMs, computer vision, and frontend product design. I like taking ambiguous
          problems and shaping them into clear, fast, user-ready tools.
        </p>
        <p class="text-[var(--muted)]">
          My work blends AI engineering with product thinking. I build the pipelines,
          then I craft the UI so the intelligence actually feels useful.
        </p>
        <div class="flex flex-wrap gap-3">
          <span class="chip">AI Engineer</span>
          <span class="chip">Frontend Engineer</span>
          <span class="chip">Accessibility-first</span>
        </div>
        <div class="flex flex-wrap gap-3 pt-2">
          <a class="btn btn-outline text-sm" href="mailto:saumik.kabbya@gmail.com">
            Email
          </a>
          <a class="btn btn-outline text-sm" href="https://github.com/Kabbya04" target="_blank" rel="noreferrer">
            GitHub
          </a>
          <a class="btn btn-outline text-sm" href="https://www.linkedin.com/in/saumik-saha-kabbya/" target="_blank" rel="noreferrer">
            LinkedIn
          </a>
        </div>
      </div>

      <div class="card p-6 flex flex-col items-center text-center space-y-4">
        <img
          alt="Saumik Saha Kabbya portrait"
          src="/Kabbya.png"
          class="w-56 h-56 rounded-full object-cover ring-2 ring-[var(--accent-3)]/40"
        />
        <div>
          <p class="text-sm text-[var(--muted)]">Currently based in</p>
          <p class="text-lg font-semibold">Dhaka, Bangladesh</p>
        </div>
        <div class="flex flex-wrap gap-2 justify-center">
          <span class="chip">LLMs</span>
          <span class="chip">Computer Vision</span>
          <span class="chip">Full-stack</span>
        </div>
      </div>
    </div>

    <div class="grid lg:grid-cols-2 gap-6">
      <div class="card p-6 space-y-4">
        <h2 class="text-2xl font-semibold">Experience Snapshot</h2>
        <p class="text-[var(--muted)]">
          {experience[0]?.description ??
            "At The Data Island, I shipped AI and computer vision solutions using FastAPI, Groq AI, Ultralytics YOLO, and PyTorch, alongside Next.js for the frontend."}
        </p>
        {experience[0]?.tags && (
          <div class="flex flex-wrap gap-2">
            {experience[0].tags.map((tag) => (
              <span class="chip">{tag}</span>
            ))}
          </div>
        )}
      </div>
      <div class="card p-6 space-y-4">
        <h2 class="text-2xl font-semibold">Education</h2>
        <p class="text-[var(--muted)]">
          {education[0]?.subtitle} at {education[0]?.title} ({formatPeriod(education[0]?.start ?? "2022-01", education[0]?.end)}).
        </p>
        {education[0]?.tags && (
          <div class="flex flex-wrap gap-2">
            {education[0].tags.map((tag) => (
              <span class="chip">{tag}</span>
            ))}
          </div>
        )}
      </div>
    </div>

    <div class="space-y-6">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <div class="space-y-2">
          <p class="eyebrow">Timeline</p>
          <h2 class="text-2xl md:text-3xl font-semibold">Progress Ladder</h2>
        </div>
        <p class="text-[var(--muted)] max-w-xl">
          A quick view of how my education, work, and standout projects have unfolded.
        </p>
      </div>

      <div class="timeline">
        {sortedTimeline.map((entry, index) => (
          <div class={`timeline-row ${index % 2 === 0 ? "left" : "right"}`}>
            {index % 2 === 0 ? (
              <>
                <div class="timeline-card">
                  <span class="timeline-date">
                    {formatPeriod(entry.start, entry.end)}
                  </span>
                  <h3>{entry.title}</h3>
                  <p>{entry.subtitle}</p>
                </div>
                <div class="timeline-spine"><span class="timeline-dot"></span></div>
                <div class="timeline-empty"></div>
              </>
            ) : (
              <>
                <div class="timeline-empty"></div>
                <div class="timeline-spine"><span class="timeline-dot"></span></div>
                <div class="timeline-card">
                  <span class="timeline-date">
                    {formatPeriod(entry.start, entry.end)}
                  </span>
                  <h3>{entry.title}</h3>
                  <p>{entry.subtitle}</p>
                </div>
              </>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .timeline {
    display: grid;
    gap: 1.2rem;
    position: relative;
  }

  .timeline-row {
    display: grid;
    grid-template-columns: 1fr 64px 1fr;
    align-items: center;
    position: relative;
  }

  .timeline::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--border);
    opacity: 0.6;
    transform: translateX(-50%);
  }

  .timeline-date {
    display: inline-flex;
    align-self: flex-start;
    font-size: 0.85rem;
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }

  .timeline-spine {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100%;
  }

  .timeline-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 6px rgba(183, 255, 90, 0.12);
    z-index: 1;
  }

  .timeline-empty {
    min-height: 1px;
  }

  .timeline-card {
    background: rgba(12, 18, 28, 0.6);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 0.9rem 1.2rem;
    position: relative;
    width: min(100%, 340px);
  }

  .timeline-row.left .timeline-card {
    justify-self: end;
    text-align: right;
  }

  .timeline-row.right .timeline-card {
    justify-self: start;
    text-align: left;
  }

  .timeline-card h3 {
    font-size: 1rem;
    margin-bottom: 0.15rem;
  }

  .timeline-card p {
    color: var(--muted);
    font-size: 0.9rem;
  }

  @media (max-width: 768px) {
    .timeline-row {
      grid-template-columns: 24px 1fr;
      gap: 0.75rem;
    }

    .timeline::before {
      left: 12px;
    }

    .timeline-card {
      margin-left: 0;
      width: 100%;
      text-align: left;
      grid-column: 2;
    }

    .timeline-empty {
      display: none;
    }

    .timeline-spine {
      grid-column: 1;
    }
  }
</style>
