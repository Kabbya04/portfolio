---
import { education, experience, projects, formatPeriod } from "@/data/portfolio";

const timelineEntries = [
  ...education.map((entry, index) => ({ ...entry, order: index })),
  ...experience.map((entry, index) => ({
    ...entry,
    order: education.length + index,
  })),
  ...projects.map((entry, index) => ({
    ...entry,
    order: education.length + experience.length + index,
  })),
];

const parseStartIndex = (value: string) => {
  const [year, month] = value.split("-");
  const y = Number(year);
  const m = month ? Number(month) : 1;
  return y * 12 + m;
};

const sortedTimeline = [...timelineEntries].sort((a, b) => {
  const diff = parseStartIndex(b.start) - parseStartIndex(a.start);
  return diff !== 0 ? diff : a.order - b.order;
});
---

<section class="text-[var(--text)] mt-8 sm:mt-12 md:mt-0" id="about">
  <div class="max-w-6xl mx-auto md:py-28 py-10 sm:pb-16 space-y-10 sm:space-y-14">
    <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-8 sm:gap-12 items-center">
      <div class="space-y-5 sm:space-y-6 min-w-0">
        <p class="eyebrow">About</p>
        <h1 class="font-display text-[2rem] leading-[1.15] sm:text-4xl md:text-5xl md:leading-tight">
          Designing AI experiences that feel intuitive.
        </h1>
        <p class="text-base sm:text-lg text-[var(--muted)]">
          I’m Saumik Saha Kabbya, a computer science graduate in Dhaka with a focus on
          LLMs, computer vision, and frontend product design. I like taking ambiguous
          problems and shaping them into clear, fast, user-ready tools.
        </p>
        <p class="text-[var(--muted)] text-sm sm:text-base">
          My work blends AI engineering with product thinking. I build the pipelines,
          then I craft the UI so the intelligence actually feels useful.
        </p>
        <div class="flex flex-wrap gap-2 sm:gap-3">
          <span class="chip">AI Engineer</span>
          <span class="chip">Full Stack Engineer</span>
          <span class="chip">Accessibility-first</span>
        </div>
        <div class="flex flex-wrap gap-2 sm:gap-3 pt-2">
          <a class="btn btn-outline text-sm" href="mailto:saumik.kabbya@gmail.com">
            Email
          </a>
          <a class="btn btn-outline text-sm" href="https://github.com/Kabbya04" target="_blank" rel="noreferrer">
            GitHub
          </a>
          <a class="btn btn-outline text-sm" href="https://www.linkedin.com/in/saumik-saha-kabbya/" target="_blank" rel="noreferrer">
            LinkedIn
          </a>
        </div>
      </div>

      <div class="card p-4 sm:p-6 flex flex-col items-center text-center space-y-4">
        <img
          alt="Saumik Saha Kabbya portrait"
          src="/Kabbya.png"
          class="w-40 h-40 sm:w-56 sm:h-56 rounded-full object-cover ring-2 ring-[var(--accent-3)]/40"
        />
        <div>
          <p class="text-sm text-[var(--muted)]">Currently based in</p>
          <p class="text-base sm:text-lg font-semibold">Dhaka, Bangladesh</p>
        </div>
        <div class="flex flex-wrap gap-2 justify-center">
          <span class="chip">LLMs</span>
          <span class="chip">Computer Vision</span>
          <span class="chip">Full-stack</span>
        </div>
      </div>
    </div>

    <div class="grid lg:grid-cols-2 gap-4 sm:gap-6">
      <div class="card p-4 sm:p-6 space-y-4">
        <div class="space-y-1">
          <h2 class="text-xl sm:text-2xl font-semibold">Experience Snapshot</h2>
          <p class="text-sm text-[var(--muted)]">Three roles, newest first.</p>
        </div>
        <div class="experience-snapshot-list" role="list">
          {
            experience.map((role) => (
              <article class="experience-snapshot-item" role="listitem">
                <div class="experience-snapshot-top">
                  <div class="min-w-0 space-y-0.5">
                    <h3 class="experience-snapshot-title">{role.title}</h3>
                    <p class="experience-snapshot-role">{role.subtitle}</p>
                  </div>
                  <div class="experience-snapshot-meta">
                    {role.badge && <span class="chip shrink-0">{role.badge}</span>}
                    <p class="experience-snapshot-period">{formatPeriod(role.start, role.end)}</p>
                  </div>
                </div>
                {role.description && (
                  <p class="experience-snapshot-body">{role.description}</p>
                )}
              </article>
            ))
          }
        </div>
      </div>
      <div class="card p-4 sm:p-6 space-y-4">
        <h2 class="text-xl sm:text-2xl font-semibold">Education</h2>
        <p class="text-[var(--muted)] text-sm sm:text-base">
          {education[0]?.subtitle} at {education[0]?.title} ({formatPeriod(education[0]?.start ?? "2022-01", education[0]?.end)}).
        </p>
        {education[0]?.description && (
          <p class="text-[var(--muted)] text-sm sm:text-base">{education[0].description}</p>
        )}
        {education[0]?.tags && (
          <div class="flex flex-wrap gap-2">
            {education[0].tags.map((tag) => (
              <span class="chip">{tag}</span>
            ))}
          </div>
        )}
      </div>
    </div>

    <div class="space-y-6">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 sm:gap-6">
        <div class="space-y-2 min-w-0">
          <p class="eyebrow">Timeline</p>
          <h2 class="text-xl sm:text-2xl md:text-3xl font-semibold">Progress Ladder</h2>
        </div>
        <p class="text-[var(--muted)] max-w-xl text-sm sm:text-base">
          A quick view of how my education, work, and standout projects have unfolded.
        </p>
      </div>

      <div class="timeline">
        {sortedTimeline.map((entry, index) => (
          <div class={`timeline-row ${index % 2 === 0 ? "left" : "right"}`}>
            {index % 2 === 0 ? (
              <>
                <div class="timeline-card">
                  <span class="timeline-date">
                    {formatPeriod(entry.start, entry.end)}
                  </span>
                  <h3>{entry.title}</h3>
                  <p>{entry.subtitle}</p>
                </div>
                <div class="timeline-spine"><span class="timeline-dot"></span></div>
                <div class="timeline-empty"></div>
              </>
            ) : (
              <>
                <div class="timeline-empty"></div>
                <div class="timeline-spine"><span class="timeline-dot"></span></div>
                <div class="timeline-card">
                  <span class="timeline-date">
                    {formatPeriod(entry.start, entry.end)}
                  </span>
                  <h3>{entry.title}</h3>
                  <p>{entry.subtitle}</p>
                </div>
              </>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .experience-snapshot-list {
    display: flex;
    flex-direction: column;
  }

  .experience-snapshot-item {
    padding: 0.95rem 0;
    border-top: 1px solid var(--border);
  }

  .experience-snapshot-item:first-child {
    padding-top: 0.35rem;
    border-top: none;
  }

  .experience-snapshot-item:last-child {
    padding-bottom: 0;
  }

  .experience-snapshot-top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 0.45rem;
  }

  .experience-snapshot-title {
    font-family: "Syne", "Space Grotesk", system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--text);
  }

  .experience-snapshot-role {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .experience-snapshot-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;
    text-align: right;
  }

  .experience-snapshot-period {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .experience-snapshot-body {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .timeline {
    display: grid;
    gap: 1rem;
    position: relative;
  }

  .timeline-row {
    display: grid;
    grid-template-columns: 1fr 48px 1fr;
    align-items: center;
    position: relative;
  }

  @media (min-width: 1024px) {
    .timeline-row {
      grid-template-columns: 1fr 64px 1fr;
    }
  }

  .timeline::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--border);
    opacity: 0.6;
    transform: translateX(-50%);
  }

  .timeline-date {
    display: inline-flex;
    align-self: flex-start;
    font-size: 0.75rem;
    color: var(--muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0.35rem;
    word-break: break-word;
  }

  .timeline-spine {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100%;
  }

  .timeline-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 6px var(--accent-rgb, rgba(183, 255, 90, 0.12));
    z-index: 1;
  }

  :root[data-theme="light"] .timeline-dot {
    box-shadow: 0 0 0 6px rgba(44, 126, 251, 0.12);
  }

  .timeline-empty {
    min-height: 1px;
  }

  .timeline-card {
    background: var(--timeline-bg);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 0.85rem 1rem;
    position: relative;
    width: min(100%, 340px);
    min-width: 0;
  }

  .timeline-row.left .timeline-card {
    justify-self: end;
    text-align: right;
  }

  .timeline-row.right .timeline-card {
    justify-self: start;
    text-align: left;
  }

  .timeline-card h3 {
    font-size: 0.95rem;
    margin-bottom: 0.15rem;
    word-break: break-word;
  }

  .timeline-card p {
    color: var(--muted);
    font-size: 0.85rem;
    word-break: break-word;
  }

  @media (max-width: 899px) {
    .timeline-row {
      grid-template-columns: 24px minmax(0, 1fr);
      gap: 0.75rem;
    }

    .timeline::before {
      left: 12px;
    }

    .timeline-card {
      margin-left: 0;
      width: 100%;
      max-width: none;
      text-align: left !important;
      justify-self: stretch !important;
      grid-column: 2;
    }

    .timeline-empty {
      display: none;
    }

    .timeline-spine {
      grid-column: 1;
      grid-row: 1;
    }

    .timeline-date {
      letter-spacing: 0.04em;
    }
  }
</style>
