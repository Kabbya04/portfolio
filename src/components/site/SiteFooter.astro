---
import { navLinks, site } from "@/data/site";
---

<footer class="site-footer section section--tight section--deep">
  <div class="site-shell footer-grid">
    <div class="footer-brand">
      <p class="wordmark">
        Kabb<span>ya</span>
      </p>
      <p class="lede footer-lede">
        AI tools, research notes, and interfaces built in Dhaka.
      </p>
    </div>

    <div>
      <p class="eyebrow">Navigate</p>
      <ul class="footer-links">
        {navLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </div>

    <div>
      <p class="eyebrow">Connect</p>
      <ul class="footer-links">
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={site.github} target="_blank" rel="noreferrer">GitHub</a></li>
        <li><a href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn</a></li>
        <li><a href={site.resume} target="_blank" rel="noreferrer">Resume</a></li>
        <li>
          <a href={site.academicResume} target="_blank" rel="noreferrer"
            >Academic Resume</a
          >
        </li>
      </ul>
    </div>
  </div>

  <div class="site-shell footer-bottom">
    <hr class="rule" />
    <p class="meta">© {new Date().getFullYear()} {site.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-dark);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .wordmark {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: 1.85rem;
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .wordmark span {
    font-style: italic;
    font-weight: 400;
    color: var(--coral);
  }

  .footer-lede {
    margin: 0;
  }

  .footer-links {
    list-style: none;
    margin: 0.85rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .footer-links a {
    text-decoration: none;
    color: var(--text-muted-on-dark);
  }

  .footer-links a:hover {
    color: var(--coral);
  }

  .footer-bottom {
    margin-top: 2.25rem;
  }

  .footer-bottom .meta {
    margin: 1rem 0 0;
    color: var(--text-muted-on-dark);
  }

  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
