---
import { projects, formatPeriod } from "@/data/portfolio";
---

<section id="projects" class="py-16 border-t border-[var(--border)]">
  <div class="max-w-6xl mx-auto space-y-8">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
      <div class="space-y-2">
        <p class="eyebrow">Projects</p>
        <h2 class="font-display text-3xl md:text-4xl">Selected builds</h2>
      </div>
      <p class="text-[var(--muted)] max-w-xl">
        AI-driven tools, recommendation systems, and accessibility-first products that ship
        with clarity and speed.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {
        projects.map((project) => (
          <div class="project-card" style={`--accent-color:${project.accent};`}>
            <div class="project-glow" />
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-sm text-[var(--muted)]">
                  {formatPeriod(project.start, project.end)}
                </p>
                <h3 class="text-2xl font-semibold mt-1">{project.title}</h3>
              </div>
                <div class="flex items-center gap-2">
                {project.github && (
                  <a
                    class="project-link"
                    href={project.github}
                    target="_blank"
                    rel="noreferrer"
                    aria-label={`${project.title} GitHub`}
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="size-5"
                    >
                      <path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z" />
                    </svg>
                  </a>
                )}
                {project.live && (
                  <a
                    class="project-link"
                    href={project.live}
                    target="_blank"
                    rel="noreferrer"
                    aria-label={`${project.title} Live`}
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="size-5"
                    >
                      <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
                    </svg>
                  </a>
                )}
              </div>
            </div>
            <p class="text-[var(--muted)] mt-4">{project.description}</p>
            <div class="flex flex-wrap gap-2 mt-4">
              {project.tags.map((tag) => (
                <span class="chip text-xs">{tag}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <a
      target="_blank"
      href="https://github.com/Kabbya04?tab=repositories"
      aria-label="GitHub"
      class="btn btn-outline w-full md:w-auto justify-center"
      rel="noreferrer"
    >
      More projects on GitHub
    </a>
  </div>
</section>

<style>
  .project-card {
    position: relative;
    overflow: hidden;
    padding: 1.75rem;
    border-radius: 24px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-soft);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .project-glow {
    position: absolute;
    inset: -40% 40% auto auto;
    width: 220px;
    height: 220px;
    background: radial-gradient(circle, var(--accent-color) 0%, transparent 65%);
    opacity: 0.35;
    filter: blur(10px);
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.35s ease;
  }

  @media (hover: hover) {
    .project-card:hover {
      transform: translateY(-4px);
      border-color: var(--accent-color);
      box-shadow: var(--shadow-strong);
    }

    .project-card:hover .project-glow {
      opacity: 0.6;
      transform: translateX(-8px);
    }
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--text);
    background: rgba(16, 24, 36, 0.6);
    transition: all 0.2s ease;
  }

  :root[data-theme="light"] .project-link {
    background: rgba(255, 255, 255, 0.6);
  }

  .project-link:hover {
    border-color: var(--accent-color);
    color: var(--accent-color);
  }
</style>
