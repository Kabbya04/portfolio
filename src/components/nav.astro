---

<div class="flex justify-center w-full">
  <nav
    id="main-nav"
    class="fixed left-1/2 -translate-x-1/2 z-[100] bg-[var(--nav-bg)] border border-transparent backdrop-blur-xl transition-all duration-500 ease-in-out md:top-6 md:bottom-auto bottom-0 w-[min(92%,56rem)]"
  >
    <div class="mx-auto flex justify-center items-center px-2 py-2 sm:p-3">
      <ul
        class="flex w-full items-stretch justify-between gap-0.5 sm:gap-2 md:justify-center md:gap-8 lg:gap-12"
      >
        {
          navItems.map((item) => (
            <li class="flex-1 md:flex-none min-w-0">
              <a
                href={item.href}
                class="nav-link flex flex-col items-center justify-center gap-0.5 text-[var(--muted)] hover:text-[var(--text)] transition-colors relative group min-h-11 px-0.5"
                aria-label={item.label}
              >
                <div class="absolute -left-5 top-1/2 -translate-y-1/2 w-2 h-2 rounded-full transition-all duration-300 scale-0 opacity-0 bg-[var(--accent)] nav-indicator hidden md:block" />
                <span class="md:hidden flex items-center justify-center w-5 h-5 shrink-0">
                  <fragment set:html={item.icon} />
                </span>
                <span class="hidden md:inline-block text-sm lg:text-base">{item.label}</span>
                <span class="nav-mobile-label md:hidden">{item.label}</span>
              </a>
            </li>
          ))
        }
        <li class="flex-1 md:flex-none min-w-0">
          <button
            id="theme-toggle"
            type="button"
            class="nav-link flex flex-col items-center justify-center gap-0.5 text-[var(--muted)] hover:text-[var(--text)] transition-colors relative group min-h-11 w-full px-0.5"
            aria-label="Toggle theme"
          >
            <span class="flex items-center justify-center w-5 h-5 shrink-0">
              <svg class="theme-icon theme-icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 4.75C12.4142 4.75 12.75 4.41421 12.75 4V2C12.75 1.58579 12.4142 1.25 12 1.25C11.5858 1.25 11.25 1.58579 11.25 2V4C11.25 4.41421 11.5858 4.75 12 4.75ZM12 22.75C12.4142 22.75 12.75 22.4142 12.75 22V20C12.75 19.5858 12.4142 19.25 12 19.25C11.5858 19.25 11.25 19.5858 11.25 20V22C11.25 22.4142 11.5858 22.75 12 22.75ZM4.75 12C4.75 11.5858 4.41421 11.25 4 11.25H2C1.58579 11.25 1.25 11.5858 1.25 12C1.25 12.4142 1.58579 12.75 2 12.75H4C4.41421 12.75 4.75 12.4142 4.75 12ZM22.75 12C22.75 11.5858 22.4142 11.25 22 11.25H20C19.5858 11.25 19.25 11.5858 19.25 12C19.25 12.4142 19.5858 12.75 20 12.75H22C22.4142 12.75 22.75 12.4142 22.75 12ZM6.21751 6.21751C6.51041 5.92462 6.51041 5.44975 6.21751 5.15685L4.8033 3.74264C4.51041 3.44975 4.03553 3.44975 3.74264 3.74264C3.44975 4.03553 3.44975 4.51041 3.74264 4.8033L5.15685 6.21751C5.44975 6.51041 5.92462 6.51041 6.21751 6.21751ZM20.2574 20.2574C20.5503 19.9645 20.5503 19.4896 20.2574 19.1967L18.8431 17.7825C18.5503 17.4896 18.0754 17.4896 17.7825 17.7825C17.4896 18.0754 17.4896 18.5503 17.7825 18.8431L19.1967 20.2574C19.4896 20.5503 19.9645 20.5503 20.2574 20.2574ZM17.7825 6.21751C18.0754 6.51041 18.5503 6.51041 18.8431 6.21751L20.2574 4.8033C20.5503 4.51041 20.5503 4.03553 20.2574 3.74264C19.9645 3.44975 19.4896 3.44975 19.1967 3.74264L17.7825 5.15685C17.4896 5.44975 17.4896 5.92462 17.7825 6.21751ZM3.74264 20.2574C4.03553 20.5503 4.51041 20.5503 4.8033 20.2574L6.21751 18.8431C6.51041 18.5503 6.51041 18.0754 6.21751 17.7825C5.92462 17.4896 5.44975 17.4896 5.15685 17.7825L3.74264 19.1967C3.44975 19.4896 3.44975 19.9645 3.74264 20.2574ZM12 7.25C9.37665 7.25 7.25 9.37665 7.25 12C7.25 14.6234 9.37665 16.75 12 16.75C14.6234 16.75 16.75 14.6234 16.75 12C16.75 9.37665 14.6234 7.25 12 7.25Z" />
              </svg>
              <svg class="theme-icon theme-icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M10.22 2.2C10.72 2.14 11.18 2.5 11.12 3C10.62 7.2 13.58 10.9 17.7 11.4C18.2 11.46 18.56 11.92 18.5 12.42C17.93 17.45 13.54 21.25 8.35 21.25C2.98 21.25 -1.07 16.39 -0.13 11.12C0.7 6.47 5.07 2.65 10.22 2.2Z" />
              </svg>
            </span>
            <span class="nav-mobile-label md:hidden">Theme</span>
          </button>
        </li>
      </ul>
    </div>
  </nav>
</div>
<style>
  nav {
    transform: translateX(-50%);
    background-color: var(--nav-bg);
    transition:
      background-color 0.3s ease,
      border-radius 0.3s ease,
      border-color 0.3s ease;
  }

  nav.scrolling {
    background-color: var(--nav-bg-solid);
    border-color: var(--border);
    border-radius: 9999px;
  }

  nav a.active .nav-indicator {
    transform: translateY(-50%) scale(1);
    opacity: 1;
  }

  nav a.active {
    color: var(--text) !important;
  }

  .nav-mobile-label {
    font-size: 0.58rem;
    line-height: 1.1;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-align: center;
  }

  .theme-icon {
    width: 18px;
    height: 18px;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease;
  }

  :root[data-theme="light"] .theme-icon-sun {
    display: none;
  }

  :root[data-theme="dark"] .theme-icon-moon {
    display: none;
  }

  .theme-icon-sun {
    animation: sun-rotate 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .theme-icon-moon {
    animation: moon-rotate 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @keyframes sun-rotate {
    0% {
      transform: rotate(-90deg) scale(0.5);
      opacity: 0;
    }
    50% {
      transform: rotate(45deg) scale(1.2);
      opacity: 1;
    }
    100% {
      transform: rotate(0deg) scale(1);
      opacity: 1;
    }
  }

  @keyframes moon-rotate {
    0% {
      transform: rotate(90deg) scale(0.5);
      opacity: 0;
    }
    50% {
      transform: rotate(-45deg) scale(1.2);
      opacity: 1;
    }
    100% {
      transform: rotate(0deg) scale(1);
      opacity: 1;
    }
  }

  #theme-toggle:hover .theme-icon {
    transform: scale(1.1);
  }

  #theme-toggle:active .theme-icon {
    transform: scale(0.95);
  }

  @media (max-width: 767px) {
    nav {
      width: 100% !important;
      max-width: 100%;
      transform: translateX(-50%);
      bottom: 0;
      left: 50%;
      position: fixed;
      border-radius: 1rem 1rem 0 0;
      border-color: var(--border);
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }

    nav.scrolling {
      border-radius: 1rem 1rem 0 0;
      background-color: var(--nav-bg-solid);
    }

    body {
      padding-bottom: calc(4.75rem + env(safe-area-inset-bottom, 0px));
    }
  }

  @media (max-width: 379px) {
    .nav-mobile-label {
      display: none;
    }

    .nav-link {
      min-height: 2.75rem;
    }
  }

  @media (min-width: 380px) and (max-width: 767px) {
    .nav-mobile-label {
      font-size: 0.62rem;
    }
  }
</style>

<script>
  const nav = document.getElementById("main-nav");
  const themeToggle = document.getElementById("theme-toggle");
  let rafId: number | null = null;

  function updateNav() {
    if (window.scrollY > 0) {
      nav?.classList.add("scrolling");
    } else {
      nav?.classList.remove("scrolling");
    }
    rafId = null;
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!rafId) {
        rafId = requestAnimationFrame(updateNav);
      }
    },
    { passive: true }
  );

  themeToggle?.addEventListener("click", () => {
    const root = document.documentElement;
    const currentTheme = root.dataset.theme || "dark";
    const nextTheme = currentTheme === "dark" ? "light" : "dark";
    
    // Trigger icon animation
    const sunIcon = themeToggle?.querySelector(".theme-icon-sun") as HTMLElement | null;
    const moonIcon = themeToggle?.querySelector(".theme-icon-moon") as HTMLElement | null;
    
    // Remove and re-add animation classes to trigger re-animation
    if (sunIcon) {
      sunIcon.style.animation = "none";
      void sunIcon.offsetHeight; // Trigger reflow
      sunIcon.style.animation = "";
    }
    if (moonIcon) {
      moonIcon.style.animation = "none";
      void moonIcon.offsetHeight; // Trigger reflow
      moonIcon.style.animation = "";
    }
    
    root.classList.add("theme-animating");
    root.dataset.theme = nextTheme;
    localStorage.setItem("theme", nextTheme);
    themeToggle?.setAttribute("aria-pressed", String(nextTheme === "light"));
    window.setTimeout(() => {
      root.classList.remove("theme-animating");
    }, 800);
  });

  if (themeToggle) {
    const currentTheme = document.documentElement.dataset.theme || "dark";
    themeToggle.setAttribute("aria-pressed", String(currentTheme === "light"));
  }

  // Handle navigation clicks
  document.querySelectorAll('#main-nav a[href^="/"]').forEach((anchor) => {
    anchor.addEventListener("click", function (e) {
      e.preventDefault();
      const target = e.currentTarget as HTMLAnchorElement;
      const href = target.getAttribute("href") || "";
      
      if (href === "/about") {
        // Navigate to About Me page
        window.location.href = href;
      } else {
        // Navigate to home page with section
        const [path, hash] = href.split("#");
        const isHomePage = window.location.pathname === "/" || window.location.pathname === "/index.astro";
        
        if (!isHomePage) {
          // If not on home page, navigate to home with hash
          window.location.href = href;
        } else if (hash) {
          // If on home page, scroll to section
          const targetElement = document.getElementById(hash);
          if (targetElement) {
            targetElement.scrollIntoView({
              behavior: "smooth",
            });
          }
        }
      }
    });
  });

  // Handle active state for navigation
  document.addEventListener("DOMContentLoaded", () => {
    const navLinks = document.querySelectorAll("nav a[href^='/']");
    
    // Set active state based on current page
    const currentPath = window.location.pathname;
    navLinks.forEach((link) => {
      const linkHref = link.getAttribute("href") || "";
      const [linkPath] = linkHref.split("#");
      
      if (currentPath === "/about" && linkPath === "/about") {
        link.classList.add("active");
      } else if (currentPath === "/" && linkPath === "/") {
        // For home page, handle section-based active state
        const hash = linkHref.split("#")[1];
        if (!hash) {
          link.classList.add("active"); // Default to Home if no hash
        }
      }
    });

    // IntersectionObserver for home page sections
    if (window.location.pathname === "/") {
      const sections = document.querySelectorAll("section[id]");
      const observerOptions = { threshold: 0.6 };

      const observerCallback = (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            navLinks.forEach((link) => link.classList.remove("active"));
            const id = entry.target.getAttribute("id");
            const activeLink = document.querySelector(`nav a[href="/#${id}"]`);
            if (activeLink) {
              activeLink.classList.add("active");
            }
          }
        });
      };

      const observer = new IntersectionObserver(
        observerCallback,
        observerOptions
      );
      sections.forEach((section) => observer.observe(section));
    }
  });
</script>
