---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Home from "@/components/home.astro";
import Projects from "@/components/projects.astro";
import Contact from "@/components/contact.astro";
import Footer from "@/components/footer.astro";
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Saumik Saha Kabbya",
  "description": "AI Engineer and Frontend Engineer from Dhaka, Bangladesh focusing on LLMs and Computer Vision",
  "url": "https://saumik-kabbya.com",
  "sameAs": [
    "https://github.com/Kabbya04",
    "https://www.linkedin.com/in/saumik-saha-kabbya/",
    "https://www.instagram.com/kabbyasaumiksaha/",
  ]
};

const pageTitle = "Saumik Saha Kabbya"; 
const pageDescription = "Portfolio of Saumik Saha Kabbya, an AI and Frontend Engineer from Dhaka, Bangladesh building LLM and computer vision products.";

---

<Layout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <Nav />
  <Home />
  <Projects />
  <Contact />
  <Footer />
</Layout>
